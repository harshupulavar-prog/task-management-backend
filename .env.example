# Copy these settings into your ignored local .env file and fill in real values.
# Never commit .env or put email credentials in the frontend.
SECRET_KEY=replace_with_a_long_random_secret
OTP_SECRET_KEY=replace_with_a_different_long_random_secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
FRONTEND_BASE_URL=http://localhost:5173
